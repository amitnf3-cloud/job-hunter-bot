# Copy this file to .env and fill in your real values.
# .env is gitignored - never commit real secrets.
# In GitHub Actions these will instead be set as repository secrets.

ANTHROPIC_API_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# Telegram (job source) - see scripts/generate_telegram_session.py for how
# to obtain these. TELEGRAM_SESSION_STRING is equivalent to a login
# credential for your Telegram account - never commit it, only set it as
# a GitHub Actions secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
